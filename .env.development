# Everything.Rent — Development environment
# ===========================================
# Committed. Loaded by varlock when APP_ENV=development. Holds every value
# the dev environment uses — non-secret literals directly, BWS-resolved
# secrets via `bitwarden("<uuid>")` calls pointing at the `everything-rent-dev`
# Bitwarden project.
#
# The Supabase values below are the well-known LOCAL EMULATOR defaults
# printed by `supabase start`. They're public and safe to commit, but they
# only work against a Supabase instance running on your machine (Docker).
#
# Prerequisites for this environment:
#   1. Docker Desktop running
#   2. Hosts file entry:  127.0.0.1  everything.test
#   3. `npm run dev` (auto-starts local Supabase + Caddy)
#   4. `BWS_SECRETS_TOKEN` set in your shell env, pointing at the dev project

# App
NEXT_PUBLIC_SITE_URL=https://everything.test

# Supabase (LOCAL EMULATOR)
# Browser requests go through Caddy at /supabase/* (same origin, no CORS).
NEXT_PUBLIC_SUPABASE_URL=https://everything.test/supabase/
# Server-side direct access (bypasses Caddy).
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Service role key — @sensitive, never stored on disk. The dev BWS project's
# value should match the key your local emulator prints from `supabase status`.
SUPABASE_SERVICE_ROLE_KEY=bitwarden("24cf9eac-876e-4673-920b-b4270141c2cf")

# Stripe
STRIPE_SECRET_KEY=bitwarden("3597b650-7fca-47bd-b611-b4270155d996")
STRIPE_WEBHOOK_SECRET=bitwarden("b0a8c60f-5aa1-46a0-9abf-b4270155f546")
# Test-mode publishable key — shipped to browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51TMhJ2Ky7g5aMPZLPsIxYm6kSeVkED2iXpssyFxORDfSWCvkoHWB97StYVKqQ2N2f9tmM3LzpRJsHbscYUtmzAdy00PrTggE3M

# Twilio
TWILIO_ACCOUNT_SID=bitwarden("ca882dd3-6a24-4b43-b0e4-b427015615be")
TWILIO_VERIFY_SERVICE_SID=bitwarden("c898a4e4-1607-43e7-bb51-b42f0042c03f")
TWILIO_AUTH_TOKEN=bitwarden("070c7892-5fa0-4274-b0e5-b42701563ed8")
TWILIO_PHONE_NUMBER=bitwarden("c6576b39-af4e-4239-8e50-b42701565c84")

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAC-w2RvpgT85iJc7
TURNSTILE_SECRET_KEY=bitwarden("9d200635-0aa0-4c8d-a830-b42f0032ad3c")
