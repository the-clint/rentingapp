# Everything.Rent — Local Development Environment
# ================================================
# Copy this file to .env.local:   cp .env.example .env.local
#
# These are well-known defaults from `supabase start` and are NOT secrets.
# Production secrets (Stripe, Twilio, cloud Supabase) are managed via
# Varlock + Bitwarden Secrets Manager — see docs/bitwarden-secrets-setup.md.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Base URL of the Next.js dev server. Used for metadata, auth redirects,
# booking URL construction, and Supabase config.toml (via env() interpolation).
# Requires a hosts file entry:  127.0.0.1  everything.test
NEXT_PUBLIC_SITE_URL=http://everything.test

# ---------------------------------------------------------------------------
# Supabase (local emulator defaults)
# ---------------------------------------------------------------------------
# These values are printed by `supabase start` and are the same for everyone.
NEXT_PUBLIC_SUPABASE_URL=http://everything.test:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# ---------------------------------------------------------------------------
# Production-only secrets (NOT needed for local dev)
# ---------------------------------------------------------------------------
# These are resolved via Varlock + Bitwarden in production. To test Stripe
# or Twilio features locally, fill in test-mode keys below and set
# BWS_SECRETS_TOKEN as a shell env var.
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1...
