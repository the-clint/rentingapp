# Everything.Rent — Preview environment
# =======================================
# Committed. Loaded by varlock when APP_ENV=preview (Netlify deploy-preview
# and branch-deploy contexts). Holds every value the preview environment
# uses — non-secret literals directly, BWS-resolved secrets via
# `bitwarden("<uuid>")` calls pointing at the `everything-rent-preview`
# Bitwarden project.
#
# Preview runs against a dedicated cloud Supabase project (NOT the local
# emulator). The BWS machine-account token scoped to Netlify's Deploy
# Previews + Branch Deploys contexts points at this project.
#
# TODOs below resolve once the `everything-rent-preview` BWS project is
# populated and the preview Supabase instance is provisioned. See
# docs/bitwarden-secrets-setup.md.

# App
# Left blank intentionally. A custom `preview.everything.rent` subdomain would
# require a paid Netlify plan and is NOT configured. Preview deploys use
# Netlify's auto-generated URLs instead:
#   - Branch deploys:   https://<branch-name>--everything-dot-rent.netlify.app/
#                       (e.g. the `preview` branch is reachable at
#                        https://preview--everything-dot-rent.netlify.app/)
#   - Deploy previews:  https://deploy-preview-<pr#>--everything-dot-rent.netlify.app/
# `app/layout.tsx` falls back to `process.env.URL` (injected by Netlify per
# deploy) when this is empty, so each branch/PR gets the correct absolute URL.
NEXT_PUBLIC_SITE_URL=

# Supabase (cloud preview project)
NEXT_PUBLIC_SUPABASE_URL=bitwarden("7dac6cb1-d0c7-43e8-8866-b4390056f2aa")
# Preview hits the cloud Supabase directly; no local proxy.
# SUPABASE_URL intentionally omitted — falls back to NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=bitwarden("daff0236-2a7b-41ec-9c26-b4390056f34d")
SUPABASE_SERVICE_ROLE_KEY=bitwarden("be861c0a-bdce-4b83-b93f-b4390056f3ea")

# Stripe
STRIPE_SECRET_KEY=bitwarden("3e0febc5-db4b-4d95-b65b-b4390056f489")
STRIPE_WEBHOOK_SECRET=bitwarden("1660301e-2f2c-4776-981e-b4390056f51c")
# Test-mode publishable key for preview. Safe to commit.
# TODO: paste the preview Stripe account's pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=bitwarden("802d7565-f505-49d8-8f8e-b4390056f768")

# Twilio
TWILIO_ACCOUNT_SID=bitwarden("6c86de8c-02b2-4df1-a88f-b4390056f5ae")
TWILIO_VERIFY_SERVICE_SID=bitwarden("4f43be61-c7fc-41f5-8597-b4390057118c")
TWILIO_AUTH_TOKEN=bitwarden("c966032f-7f2c-4545-bead-b4390056f644")
TWILIO_PHONE_NUMBER=bitwarden("d7883619-9d93-4a96-9e23-b4390056f6d1")

# Cloudflare Turnstile
# TODO: paste the preview Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=bitwarden("996961e0-c5a4-4ad2-9089-b439005708f9")
