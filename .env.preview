# Everything.Rent — Preview environment
# =======================================
# Committed. Loaded by varlock when APP_ENV=preview (Netlify deploy-preview
# and branch-deploy contexts). Holds every value the preview environment
# uses — non-secret literals directly, BWS-resolved secrets via
# `bitwarden("<uuid>")` calls pointing at the `everything-rent-preview`
# Bitwarden project.
#
# Preview runs against a dedicated cloud Supabase project (NOT the local
# emulator). The BWS machine-account token scoped to Netlify's Deploy
# Previews + Branch Deploys contexts points at this project.
#
# TODOs below resolve once the `everything-rent-preview` BWS project is
# populated and the preview Supabase instance is provisioned. See
# docs/bitwarden-secrets-setup.md.

# App
# TODO: set to the preview site URL once Netlify preview domain is decided.
# For auto-generated deploy-preview subdomains, leave blank and rely on
# `process.env.URL` in app/layout.tsx (Netlify injects per deploy).
NEXT_PUBLIC_SITE_URL=

# Supabase (cloud preview project)
NEXT_PUBLIC_SUPABASE_URL=bitwarden("TODO-NEXT-PUBLIC-SUPABASE-URL-PREVIEW-UUID")
# Preview hits the cloud Supabase directly; no local proxy.
# SUPABASE_URL intentionally omitted — falls back to NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=bitwarden("TODO-NEXT-PUBLIC-SUPABASE-PUBLISHABLE-DEFAULT-KEY-PREVIEW-UUID")
SUPABASE_SERVICE_ROLE_KEY=bitwarden("TODO-SUPABASE-SERVICE-ROLE-KEY-PREVIEW-UUID")

# Stripe
STRIPE_SECRET_KEY=bitwarden("TODO-STRIPE-SECRET-KEY-PREVIEW-UUID")
STRIPE_WEBHOOK_SECRET=bitwarden("TODO-STRIPE-WEBHOOK-SECRET-PREVIEW-UUID")
# Test-mode publishable key for preview. Safe to commit.
# TODO: paste the preview Stripe account's pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=bitwarden("TODO-TWILIO-ACCOUNT-SID-PREVIEW-UUID")
TWILIO_VERIFY_SERVICE_SID=bitwarden("TODO-TWILIO-VERIFY-SERVICE-SID-PREVIEW-UUID")
TWILIO_AUTH_TOKEN=bitwarden("TODO-TWILIO-AUTH-TOKEN-PREVIEW-UUID")
TWILIO_PHONE_NUMBER=bitwarden("TODO-TWILIO-PHONE-NUMBER-PREVIEW-UUID")

# Cloudflare Turnstile
# TODO: paste the preview Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=bitwarden("TODO-TURNSTILE-SECRET-KEY-PREVIEW-UUID")
