# Everything.Rent — Production environment
# ==========================================
# Committed. Non-secret values only. Loaded by varlock when APP_ENV=production.
# Secrets resolve from Bitwarden project `everything-rent-prod` via the
# `bitwarden(remap(...))` calls in `.env.schema`.
#
# To deploy: set `APP_ENV=production` and the prod `BWS_SECRETS_TOKEN` in the
# hosting platform's env UI (e.g. Netlify → Site configuration → Environment variables).

# App
NEXT_PUBLIC_SITE_URL=https://everything.rent

# Supabase cloud URL and keys come from BWS via .env.schema — do NOT override.

# Stripe publishable key (pk_live_... for live payments, or pk_test_... for staging).
# TODO: replace with the operator's chosen publishable key before go-live.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile production site key.
# TODO: replace with the real production Turnstile site key before go-live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
