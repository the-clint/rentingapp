# Everything.Rent — Production environment
# ==========================================
# Committed. Loaded by varlock when APP_ENV=production (Netlify production
# context). Holds every value the production environment uses — non-secret
# literals directly, BWS-resolved secrets via `bitwarden("<uuid>")` calls
# pointing at the `everything-rent-prod` Bitwarden project.
#
# TODOs below resolve once the `everything-rent-prod` BWS project is
# populated with live values. See docs/bitwarden-secrets-setup.md.
#
# Netlify wiring: set `BWS_SECRETS_TOKEN` in Site configuration →
# Environment variables, scoped to the Production context, pointing at the
# prod machine-account token. `APP_ENV=production` is pinned in netlify.toml.

# App
NEXT_PUBLIC_SITE_URL=https://everything.rent

# Supabase (cloud production project)
NEXT_PUBLIC_SUPABASE_URL=bitwarden("TODO-NEXT-PUBLIC-SUPABASE-URL-PROD-UUID")
# SUPABASE_URL intentionally omitted — falls back to NEXT_PUBLIC_SUPABASE_URL.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=bitwarden("TODO-NEXT-PUBLIC-SUPABASE-PUBLISHABLE-DEFAULT-KEY-PROD-UUID")
SUPABASE_SERVICE_ROLE_KEY=bitwarden("TODO-SUPABASE-SERVICE-ROLE-KEY-PROD-UUID")

# Stripe
STRIPE_SECRET_KEY=bitwarden("TODO-STRIPE-SECRET-KEY-PROD-UUID")
STRIPE_WEBHOOK_SECRET=bitwarden("TODO-STRIPE-WEBHOOK-SECRET-PROD-UUID")
# Live publishable key (pk_live_...). TODO: paste before go-live.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=bitwarden("TODO-TWILIO-ACCOUNT-SID-PROD-UUID")
TWILIO_VERIFY_SERVICE_SID=bitwarden("TODO-TWILIO-VERIFY-SERVICE-SID-PROD-UUID")
TWILIO_AUTH_TOKEN=bitwarden("TODO-TWILIO-AUTH-TOKEN-PROD-UUID")
TWILIO_PHONE_NUMBER=bitwarden("TODO-TWILIO-PHONE-NUMBER-PROD-UUID")

# Cloudflare Turnstile
# TODO: paste the production Turnstile site key before go-live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=bitwarden("TODO-TURNSTILE-SECRET-KEY-PROD-UUID")
