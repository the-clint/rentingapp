# Everything.Rent Environment Schema
# ---
# This file declares the TYPE CONTRACT for every env var the app uses. It does
# NOT hold per-environment values — those live in `.env.<APP_ENV>` files which
# varlock auto-loads based on $APP_ENV. The schema declares types,
# required/optional, sensitive/public, and plugin registrations.
#
# For the full runbook (Bitwarden setup, per-env file conventions, Netlify
# wiring) see docs/bitwarden-secrets-setup.md.

# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BWS_SECRETS_TOKEN)
# @currentEnv=$APP_ENV
# ---
#
# Three environments are supported. Each has its own Bitwarden Secrets Manager
# project, its own machine-account token, and its own Supabase instance
# (development uses the local Supabase emulator; preview and production use
# dedicated cloud projects):
#   - development: project `everything-rent-dev`,     values in `.env.development`
#   - preview:     project `everything-rent-preview`, values in `.env.preview`
#   - production:  project `everything-rent-prod`,    values in `.env.production`
# `netlify.toml` pins $APP_ENV per deploy context; `scripts/dev.mjs` pins it
# to `development` for local dev. Separate projects and tokens limit blast
# radius — a leaked dev token cannot reach production secrets.

# -----------------------------------------------------------------------------
# Environment flag (consumed by @currentEnv above)
# -----------------------------------------------------------------------------
# Varlock uses this to pick dev vs prod UUIDs inside each `remap()` call below.
# `scripts/dev.mjs` sets this to `development` automatically for local dev;
# CI sets it in `.github/workflows/ci.yml`; production hosts set it in the
# deployment platform's env UI.
# @type=enum(development, preview, production) @sensitive=false
APP_ENV=development

# -----------------------------------------------------------------------------
# Bitwarden access (consumed by @initBitwarden above)
# -----------------------------------------------------------------------------
# The actual token value is NEVER written to any file. Varlock reads it from
# `process.env.BWS_SECRETS_TOKEN`. Set it in:
#   - local dev: OS env var (`setx BWS_SECRETS_TOKEN ...` on Windows,
#                `export BWS_SECRETS_TOKEN=...` on macOS/Linux)
#   - CI:        repository/organization secret injected into the job env
#   - Netlify:   Site configuration → Environment variables, scoped per
#                deploy context (preview token for deploy-preview/branch-deploy,
#                prod token for production).
# @type=bitwardenAccessToken @sensitive
BWS_SECRETS_TOKEN=

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Public origin used in canonical links, OG tags, share URLs, etc.
# Set per environment in `.env.development` / `.env.production`. Left blank
# in `.env.preview` because Netlify generates a unique deploy URL per PR /
# branch — `app/layout.tsx` falls back to Netlify's injected `URL` env var,
# and `lib/actions/auth-actions.ts` / `app/api/cron/return-reminders/route.ts`
# / `app/(operator)/listings/[listingId]/page.tsx` all have their own
# fallbacks.
# @optional @public @type=url
NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# @required @public @type=url
NEXT_PUBLIC_SUPABASE_URL=

# Server-side Supabase URL — bypasses the browser proxy in dev.
# In production this should match NEXT_PUBLIC_SUPABASE_URL (or be omitted).
# @optional @type=url @sensitive=false
SUPABASE_URL=

# @required @public @type=string
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# @required @sensitive @type=string
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Server-only secret key. Used by `lib/services/stripe.ts` to create
# PaymentIntents (Story 3-5 hold), capture them (Story 5-4), and cancel
# them (Story 4-3). NEVER exposed to the browser.
# @required @sensitive @type=string(startsWith=sk_)
STRIPE_SECRET_KEY=

# Shared secret used by `verifyWebhookSignature` in the webhook route
# `app/api/webhooks/stripe/route.ts` to authenticate inbound Stripe events.
# Rotate via the Stripe dashboard if ever leaked.
# @required @sensitive @type=string(startsWith=whsec_)
STRIPE_WEBHOOK_SECRET=

# Stripe publishable key (pk_test_... / pk_live_...). Shipped to the browser
# and consumed by the `@stripe/react-stripe-js` <Elements> provider in
# `components/payment/payment-hold-form.tsx`. Story 3-5. Non-secret — set as
# a literal in each `.env.<env>` file.
# @optional @public @type=string(startsWith=pk_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Twilio
# -----------------------------------------------------------------------------
# @required @sensitive @type=string(startsWith=AC)
TWILIO_ACCOUNT_SID=

# @sensitive @type=string
TWILIO_VERIFY_SERVICE_SID=

# @required @sensitive @type=string
TWILIO_AUTH_TOKEN=

# @required @sensitive @type=string(startsWith=+)
TWILIO_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------
# Protects the pre-booking inquiry form from bot spam. Both are optional in
# dev — verification is stubbed when the secret is unset.
# @optional @public @type=string
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# @optional @sensitive @type=string
TURNSTILE_SECRET_KEY=
