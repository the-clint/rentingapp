# Everything.Rent Environment Schema
# ---
# Secrets live in Bitwarden Secrets Manager and are pulled at load time by
# the @varlock/bitwarden-plugin. The access token is the ONLY piece of
# sensitive material that lives outside BWS — it comes from the shell env
# var `BWS_SECRETS_TOKEN` (documented in docs/bitwarden-secrets-setup.md).
#
# Replace each ` with the UUID copied from the
# corresponding secret in your BWS Secrets Manager dashboard. See the setup
# doc for the recommended naming convention (`everything-rent/<env>/<NAME>`).

# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BWS_SECRETS_TOKEN)
# @currentEnv=$APP_ENV
# ---
#
# Two environments are supported: `development` and `production`. Each has its
# own Bitwarden Secrets Manager project and machine-account token:
#   - development: project `everything-rent-dev`, token on dev machines / CI
#   - production:  project `everything-rent-prod`, token on the hosting platform
# The flag `$APP_ENV` selects which project's UUID is used for each secret via
# `remap()`. Committed non-secret per-env values live in `.env.development` and
# `.env.production`. See docs/bitwarden-secrets-setup.md for the full runbook.

# -----------------------------------------------------------------------------
# Environment flag (consumed by @currentEnv above)
# -----------------------------------------------------------------------------
# Varlock uses this to pick dev vs prod UUIDs inside each `remap()` call below.
# `scripts/dev.mjs` sets this to `development` automatically for local dev;
# CI sets it in `.github/workflows/ci.yml`; production hosts set it in the
# deployment platform's env UI.
# @type=enum(development, production)
APP_ENV=development

# -----------------------------------------------------------------------------
# Bitwarden access (consumed by @initBitwarden above)
# -----------------------------------------------------------------------------
# The actual token value is NEVER written to any file. Varlock reads it from
# `process.env.BWS_SECRETS_TOKEN`. Set it in:
#   - local dev: Windows User-scope env var (`setx BWS_SECRETS_TOKEN ...`)
#                 OR macOS/Linux shell profile (`export BWS_SECRETS_TOKEN=...`)
#   - CI:        repository/organization secret injected into the job env
# @type=bitwardenAccessToken @sensitive
BWS_SECRETS_TOKEN=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# @required @public @type=url
NEXT_PUBLIC_SUPABASE_URL=bitwarden(remap($APP_ENV, development, "65c2b7c7-910e-4cb3-ade1-b427013f7f5b", production, "TODO-NEXT-PUBLIC-SUPABASE-URL-PROD-UUID"))

# Server-side Supabase URL — bypasses the browser proxy in dev.
# In production this should match NEXT_PUBLIC_SUPABASE_URL (or be omitted).
# @optional @type=url
SUPABASE_URL=

# @required @public @type=string
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=bitwarden(remap($APP_ENV, development, "79ebd7d9-6bb6-40f7-a1d0-b427013f979e", production, "TODO-NEXT-PUBLIC-SUPABASE-PUBLISHABLE-DEFAULT-KEY-PROD-UUID"))

# @required @sensitive @type=string
SUPABASE_SERVICE_ROLE_KEY=bitwarden(remap($APP_ENV, development, "24cf9eac-876e-4673-920b-b4270141c2cf", production, "TODO-SUPABASE-SERVICE-ROLE-KEY-PROD-UUID"))

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Server-only secret key. Used by `lib/services/stripe.ts` to create
# PaymentIntents (Story 3-5 hold), capture them (Story 5-4), and cancel
# them (Story 4-3). NEVER exposed to the browser.
# @required @sensitive @type=string(startsWith=sk_)
STRIPE_SECRET_KEY=bitwarden(remap($APP_ENV, development, "3597b650-7fca-47bd-b611-b4270155d996", production, "TODO-STRIPE-SECRET-KEY-PROD-UUID"))

# Shared secret used by `verifyWebhookSignature` in the webhook route
# `app/api/webhooks/stripe/route.ts` to authenticate inbound Stripe
# events. Rotate via the Stripe dashboard if ever leaked.
# @required @sensitive @type=string(startsWith=rk_)
STRIPE_WEBHOOK_SECRET=bitwarden(remap($APP_ENV, development, "b0a8c60f-5aa1-46a0-9abf-b4270155f546", production, "TODO-STRIPE-WEBHOOK-SECRET-PROD-UUID"))

# Stripe publishable key (pk_test_... / pk_live_...). Shipped to the
# browser and consumed by the `@stripe/react-stripe-js` <Elements>
# provider in `components/payment/payment-hold-form.tsx`. Story 3-5.
# The concrete value is set in `.env.development` (test mode) and
# `.env.production` (live mode) — non-secret, committed.
# @optional @public @type=string(startsWith=pk_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Twilio
# -----------------------------------------------------------------------------
# @required @sensitive @type=string(startsWith=AC)
TWILIO_ACCOUNT_SID=bitwarden(remap($APP_ENV, development, "ca882dd3-6a24-4b43-b0e4-b427015615be", production, "TODO-TWILIO-ACCOUNT-SID-PROD-UUID"))

# @sensitive @type=string
TWILIO_VERIFY_SERVICE_SID=bitwarden(remap($APP_ENV, development, "c898a4e4-1607-43e7-bb51-b42f0042c03f", production, "TODO-TWILIO-VERIFY-SERVICE-SID-PROD-UUID"))

# @required @sensitive @type=string
TWILIO_AUTH_TOKEN=bitwarden(remap($APP_ENV, development, "070c7892-5fa0-4274-b0e5-b42701563ed8", production, "TODO-TWILIO-AUTH-TOKEN-PROD-UUID"))

# @required @sensitive @type=string(startsWith=+)
TWILIO_PHONE_NUMBER=bitwarden(remap($APP_ENV, development, "c6576b39-af4e-4239-8e50-b42701565c84", production, "TODO-TWILIO-PHONE-NUMBER-PROD-UUID"))

# -----------------------------------------------------------------------------
# Cloudflare Turnstile
# -----------------------------------------------------------------------------
# Used to protect the pre-booking inquiry form from bot spam.
# Both are optional in dev — verification is stubbed when the secret is unset.
# Public site key is set per environment in `.env.development` / `.env.production`.
# @optional @public @type=string
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# @optional @sensitive @type=string
TURNSTILE_SECRET_KEY=bitwarden(remap($APP_ENV, development, "9d200635-0aa0-4c8d-a830-b42f0032ad3c", production, "TODO-TURNSTILE-SECRET-KEY-PROD-UUID"))
