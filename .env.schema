# RentingApp Environment Schema
# ---
# Secrets live in Bitwarden Secrets Manager and are pulled at load time by
# the @varlock/bitwarden-plugin. The access token is the ONLY piece of
# sensitive material that lives outside BWS — it comes from the shell env
# var `BWS_SECRETS_TOKEN` (documented in docs/bitwarden-secrets-setup.md).
#
# Replace each ` with the UUID copied from the
# corresponding secret in your BWS Secrets Manager dashboard. See the setup
# doc for the recommended naming convention (`rentingapp/<env>/<NAME>`).

# @plugin(@varlock/bitwarden-plugin)
# @initBitwarden(accessToken=$BWS_SECRETS_TOKEN)
# ---

# -----------------------------------------------------------------------------
# Bitwarden access (consumed by @initBitwarden above)
# -----------------------------------------------------------------------------
# The actual token value is NEVER written to any file. Varlock reads it from
# `process.env.BWS_SECRETS_TOKEN`. Set it in:
#   - local dev: Windows User-scope env var (`setx BWS_SECRETS_TOKEN ...`)
#                 OR macOS/Linux shell profile (`export BWS_SECRETS_TOKEN=...`)
#   - CI:        repository/organization secret injected into the job env
# @type=bitwardenAccessToken @sensitive
BWS_SECRETS_TOKEN=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# @required @type=url
NEXT_PUBLIC_SUPABASE_URL=bitwarden("65c2b7c7-910e-4cb3-ade1-b427013f7f5b")

# @required @type=string
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=bitwarden("79ebd7d9-6bb6-40f7-a1d0-b427013f979e")

# @required @sensitive @type=string
SUPABASE_SERVICE_ROLE_KEY=bitwarden("24cf9eac-876e-4673-920b-b4270141c2cf")

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# @required @sensitive @type=string(startsWith=sk_)
STRIPE_SECRET_KEY=bitwarden("3597b650-7fca-47bd-b611-b4270155d996")

# @required @sensitive @type=string(startsWith=whsec_)
STRIPE_WEBHOOK_SECRET=bitwarden("b0a8c60f-5aa1-46a0-9abf-b4270155f546")

# -----------------------------------------------------------------------------
# Twilio
# -----------------------------------------------------------------------------
# @required @sensitive @type=string(startsWith=AC)
TWILIO_ACCOUNT_SID=bitwarden("ca882dd3-6a24-4b43-b0e4-b427015615be")

# @required @sensitive @type=string
TWILIO_AUTH_TOKEN=bitwarden("070c7892-5fa0-4274-b0e5-b42701563ed8")

# @required @sensitive @type=string(startsWith=+)
TWILIO_PHONE_NUMBER=bitwarden("c6576b39-af4e-4239-8e50-b42701565c84")
